# Copy to .env (compose reads this file). Do NOT commit the real .env.

# --- Postgres ---
POSTGRES_DB=crimegpt
POSTGRES_USER=crimegpt
POSTGRES_PASSWORD=crimegpt
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Comma-separated origins allowed to call the API (the Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
